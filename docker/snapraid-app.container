# Quadlet file for Podman systemd integration
# Place this file (and snapraid-net.network) in ~/.config/containers/systemd/ or /etc/containers/systemd/
# Then run: systemctl --user daemon-reload (or systemctl daemon-reload for system)
# Start with: systemctl --user start snapraid-app (or systemctl start for system)

[Unit]
Description=SnapRAID Web UI
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/tristanteu/snapraid-ui:latest
ContainerName=snapraid-ui
AutoUpdate=registry

# App data: config.json, snapraid.conf, schedules, logs
Volume=%h/snapraid:/app/snapraid:Z

# Data, content and parity disks, mounted at the same paths as on the host
# so the paths in snapraid.conf stay valid. Content and parity must be writable.
# No :Z here, relabeling would touch every file on the disk (labels are disabled below instead)
# Volume=/mnt/disk1:/mnt/disk1
# Volume=/mnt/disk2:/mnt/disk2
# Volume=/mnt/parity:/mnt/parity

# Login, leave both unset to keep the UI open (e.g. behind your own auth proxy)
Environment=SNAPRAID_UI_USERNAME=admin
# Password as a Podman secret, created once with:
#   printf 'your-password' | podman secret create snapraid-ui-password -
Secret=snapraid-ui-password,type=env,target=SNAPRAID_UI_PASSWORD
# Or in plain text instead of the secret:
# Environment=SNAPRAID_UI_PASSWORD=change-me
# How long a login lasts, in hours (default 168 = 7 days)
# Environment=SNAPRAID_UI_SESSION_HOURS=168

# Optional: use the host's snapraid binary instead of the bundled one
# Volume=/usr/bin/snapraid:/usr/bin/snapraid:ro
# Environment=SNAPRAID_BIN=/usr/bin/snapraid

PublishPort=3000:80
Network=snapraid-net

# Access to disks and SMART data: SnapRAID runs smartctl on the /dev/sdX node behind each mount,
# which only exists in the container with --privileged (needs rootful Podman)
SecurityLabelDisable=true
PodmanArgs=--privileged

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
