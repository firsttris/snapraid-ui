// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what SnapRAID UI builds on, plus the "Dependency Dashboard" issue listing what is open. Their own
// pull requests: SnapRAID itself (the parsers are tested against one release), Deno (backend, image
// and standalone binary) and Bun (frontend and e2e packages, the image's frontend build).
// snapraid-daemon stays an issue of upstream-release.yml, since its API has to be compared by hand.
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `bunx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  customManagers: [
    {
      // SnapRAID: every place that names the pinned release, as the bump to 15.1 (#65) changed
      // them. SNAPRAID15_REF (the SnapRAID the e2e tests build for snapraid-daemon) moves with it.
      customType: "regex",
      managerFilePatterns: [
        "/^docker/(Dockerfile|README\\.md)$/",
        "/^dev/setup\\.sh$/",
        "/^e2e/scripts/setup-tools\\.sh$/",
        "/^scripts/install\\.sh$/",
        "/^\\.github/workflows/ci\\.yml$/",
        "/^docs/(installation|architecture|development)\\.md$/",
      ],
      matchStrings: [
        "SNAPRAID_VERSION=(?<currentValue>\\d+\\.\\d+)",
        "SNAPRAID_VERSION:-(?<currentValue>\\d+\\.\\d+)",
        "SNAPRAID15_REF:-v(?<currentValue>\\d+\\.\\d+)",
        "SnapRAID CLI v(?<currentValue>\\d+\\.\\d+)",
        "SnapRAID (?<currentValue>\\d+\\.\\d+), the version of the Docker image",
        "builds SnapRAID (?<currentValue>\\d+\\.\\d+)",
        "currently (?<currentValue>\\d+\\.\\d+), built from the official release",
        "`SNAPRAID_VERSION`, default (?<currentValue>\\d+\\.\\d+)",
      ],
      depNameTemplate: "amadvance/snapraid",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
      // 15.1, 14.10; release candidates (15.0rc2) do not match and are left out
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$",
    },
    {
      // The Deno of CI and the release's standalone binary (v2.5.x: the newest patch of a minor)
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: ["deno-version: v(?<currentValue>\\d+\\.\\d+)\\.x"],
      depNameTemplate: "denoland/deno",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+)\\.\\d+$",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$",
    },
    {
      // The Deno dev/setup.sh downloads when none is installed
      customType: "regex",
      managerFilePatterns: ["/^dev/setup\\.sh$/", "/^docs/development\\.md$/"],
      matchStrings: [
        "DENO_VERSION:-(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "`DENO_VERSION`, default (?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      depNameTemplate: "denoland/deno",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      // "packageManager": "bun@x.y.z" in frontend/ and e2e/: the Bun of every CI job
      // (bun-version-file, and the npm-installed Bun of the screenshots job in the Playwright image)
      customType: "regex",
      managerFilePatterns: ["/^(frontend|e2e)/package\\.json$/"],
      matchStrings: ['"packageManager": "bun@(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      depNameTemplate: "oven-sh/bun",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^bun-v(?<version>.+)$",
    },
  ],
  packageRules: [
    {
      // The builder's base, not shipped; and SnapRAID UI's own image
      matchPackageNames: ["docker.io/library/debian", "tristanteu/snapraid-ui"],
      enabled: false,
    },
    {
      matchPackageNames: ["amadvance/snapraid"],
      groupName: "SnapRAID",
      sourceUrl: "https://github.com/amadvance/snapraid",
      commitMessageTopic: "SnapRAID",
      prBodyNotes: [
        "The parsers are tested against this one release. Before merging: read SnapRAID's [HISTORY](https://github.com/amadvance/snapraid/blob/master/HISTORY) for changes to the structured log (`--log`); the end-to-end tests of this PR build and run the new release. Locally: `SNAPRAID_VERSION=<new> dev/setup.sh --reset`, then status, diff, sync, scrub, check, list, dup, touch and smart in the UI. A major version: compare the log tags with `backend/src/parsers/__tests__/fixtures/`, and the text \"SnapRAID 15\" in docs/installation.md. Check whether snapraid-daemon (`REVIEWED_DAEMON_VERSION`) needs this release; docs/automation.md names the versions the daemon mode was tested with.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // Deno of the image, CI, the binary and dev/setup.sh in one PR, so they do not drift apart
      matchPackageNames: ["docker.io/denoland/deno", "denoland/deno"],
      groupName: "Deno",
      sourceUrl: "https://github.com/denoland/deno",
      prBodyNotes: [
        "The image, CI (`deno-version`), the standalone binary (`deno compile` in release.yml) and `dev/setup.sh` move together. Check `deno check` and the end-to-end tests against the image and the binary.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // Bun of the image's frontend-builder (oven/bun) and packageManager in frontend/ and e2e/ in
      // one PR, so CI tests the Bun the image builds with
      matchPackageNames: ["docker.io/oven/bun", "oven/bun", "oven-sh/bun"],
      groupName: "Bun",
      sourceUrl: "https://github.com/oven-sh/bun",
      prBodyNotes: [
        "The image's `frontend-builder` (`oven/bun:<version>-slim` in docker/Dockerfile) and `packageManager` in `frontend/package.json` and `e2e/package.json` (CI's `bun-version-file` and the screenshots job's `npm install bun@…`) move together. Bun installs, runs Vite and Vitest (`bun --bun`); Playwright's test runner still runs on Node. Check the frontend job and the end-to-end tests against the image.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
  ],
}
